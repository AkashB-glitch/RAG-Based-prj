# ==============================================================================
# PermRAG Production & Local Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Environment profile: "prod" | "dev" | "test"
ENV=dev
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true

# ------------------------------------------------------------------------------
# PostgreSQL Database URLs & Least-Privilege Roles
# ------------------------------------------------------------------------------
# Owner: runs Alembic migrations & initial seeding ONLY. NEVER used by runtime API.
OWNER_DATABASE_URL=postgresql+psycopg://permrag_owner:owner_password@localhost:5432/permrag

# App User: runtime API connection. Enforces PostgreSQL RLS (tenant + ACL).
APP_DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/permrag
APP_DB_PASSWORD=app_password

# Worker: background document ingestion. Enforces PostgreSQL RLS (tenant isolation).
WORKER_DATABASE_URL=postgresql+asyncpg://rag_worker:worker_password@localhost:5432/permrag
WORKER_DB_PASSWORD=worker_password

# ------------------------------------------------------------------------------
# JWT Authentication & Principal Validation
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=permrag-dev
JWT_AUDIENCE=permrag-api
JWT_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# Embeddings & Vector Search (384-dimensional pgvector)
# ------------------------------------------------------------------------------
# "fastembed" (local ONNX bge-small-en-v1.5) or "fake" (deterministic hashed, test/CI)
EMBEDDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
MODEL_CACHE_DIR=./.models

# ------------------------------------------------------------------------------
# Week 5: Advanced Retrieval, Reranking & Deduplication
# ------------------------------------------------------------------------------
# Reranker provider: "mock" (deterministic) | "fastembed" | "cross-encoder"
RERANKER_PROVIDER=mock
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CANDIDATE_K=30
FINAL_K=5
MAX_CHUNKS_PER_DOCUMENT=2
DEDUP_SIMILARITY_THRESHOLD=0.85
ENABLE_QUERY_EXPANSION=true
ENABLE_RERANKING=true
ENABLE_DEDUPLICATION=true

# ------------------------------------------------------------------------------
# LLM Generation & Context Budgeting
# ------------------------------------------------------------------------------
# Provider: "mock" (test/CI, zero cost) | "openai" (OpenAI-compatible endpoints)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30.0

MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_TOKENS=4000
MAX_CHUNK_LENGTH=1500

# ------------------------------------------------------------------------------
# Rate Limiting & File Upload Security
# ------------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_RAG_PER_MINUTE=60
MAX_UPLOAD_BYTES=10485760
